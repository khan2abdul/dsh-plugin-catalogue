{
  "name": "dsh-plugin-catalogue",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A browsable catalogue of every DeepSeek Harness plugin, bundle and agent preset, rendered in the Harness design language.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && firebase deploy --only hosting",
    "typecheck": "tsc --noEmit",
    "build:data": "node tools/build-data.cjs",
    "check": "node tools/smoke.mjs && node tools/check-plain.cjs"
  },
  "dependencies": {
    "marked": "^18.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
